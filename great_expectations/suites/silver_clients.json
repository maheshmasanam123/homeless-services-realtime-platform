{
  "expectation_suite_name": "silver_clients",
  "expectations": [
    {"expectation_type": "expect_column_values_to_not_be_null", "kwargs": {"column": "ClientID_hash"}},
    {"expectation_type": "expect_column_values_to_match_regex", "kwargs": {"column": "ClientID_hash", "regex": "^[a-f0-9]{64}$"}},
    {"expectation_type": "expect_column_values_to_match_regex", "kwargs": {"column": "SSN_hash",      "regex": "^[a-f0-9]{64}$"}},
    {"expectation_type": "expect_column_values_to_be_in_set",   "kwargs": {"column": "VeteranStatus", "value_set": [0, 1]}},
    {"expectation_type": "expect_table_columns_to_not_match_set",
     "kwargs": {"column_set": ["SSN","FirstName","LastName","DOB","PersonalEmail"]}}
  ]
}
